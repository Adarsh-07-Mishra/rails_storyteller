<%= form_with model: @project do |form| %>

  <% if @project.errors.any? %>

    <div class="bg-red-50 border border-red-300 rounded-lg p-4 mb-6">

      <h2 class="font-semibold text-red-700 mb-2">
        Please fix the following errors:
      </h2>

      <ul class="list-disc list-inside text-red-600">

        <% @project.errors.full_messages.each do |message| %>

          <li><%= message %></li>

        <% end %>

      </ul>

    </div>

  <% end %>

  <div class="mb-6">

    <%= form.label :name,
                   class: "block font-medium mb-2" %>

    <%= form.text_field :name,
                        class: "w-full border rounded-lg p-3",
                        placeholder: "Discourse" %>

  </div>

  <div class="mb-6">

    <%= form.label :github_url,
                   "GitHub Repository URL",
                   class: "block font-medium mb-2" %>

    <%= form.url_field :github_url,
                       class: "w-full border rounded-lg p-3",
                       placeholder: "https://github.com/discourse/discourse" %>

  </div>

  <%= form.submit "Create Project",
                  class: "bg-blue-600 text-white px-5 py-3 rounded-lg hover:bg-blue-700 cursor-pointer" %>

<% end %>