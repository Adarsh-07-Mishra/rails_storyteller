<div class="max-w-5xl mx-auto py-10">

  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">
      Rails Storyteller
    </h1>

    <%= link_to "New Project",
                new_project_path,
                class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700" %>
  </div>

  <% if @projects.any? %>

    <div class="space-y-4">

      <% @projects.each do |project| %>

        <%= link_to project_path(project),
                    class: "block border rounded-xl p-5 hover:shadow-md transition" do %>

          <div class="flex justify-between">

            <div>
              <h2 class="text-xl font-semibold">
                <%= project.name %>
              </h2>

              <p class="text-gray-500 mt-1">
                <%= project.github_url %>
              </p>
            </div>

            <div>
              <span class="px-3 py-1 rounded-full bg-gray-100">
                <%= project.status.capitalize %>
              </span>
            </div>

          </div>

        <% end %>

      <% end %>

    </div>

  <% else %>

    <div class="border rounded-xl p-10 text-center">

      <h2 class="text-2xl font-semibold mb-2">
        No Projects Yet
      </h2>

      <p class="text-gray-500">
        Add your first public Rails GitHub repository.
      </p>

    </div>

  <% end %>

</div>