<div class="max-w-5xl mx-auto py-10">

  <h1 class="text-4xl font-bold mb-6">
    <%= @project.name %>
  </h1>

  <div class="border rounded-xl p-6">

    <p class="mb-4">
      <strong>Repository:</strong>

      <%= @project.github_url %>
    </p>

    <p class="mb-4">
      <strong>Status:</strong>

      <%= @project.status.capitalize %>
    </p>

    <hr class="my-6">

    <button
      disabled
      class="bg-gray-300 text-gray-700 px-5 py-3 rounded-lg cursor-not-allowed">

      Analyze Repository (Coming Soon)

    </button>

  </div>

</div>