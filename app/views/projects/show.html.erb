<div class="max-w-5xl mx-auto py-10">

  <h1 class="text-4xl font-bold mb-6">
    <%= @project.name %>
  </h1>

  <div class="border rounded-xl p-6">

    <p class="mb-4">
      <strong>Repository:</strong>
      <%= @project.github_url %>
    </p>

    <div class="mb-4">
      <strong>Status:</strong>

      <span class="<%= project_status_class(@project) %> px-3 py-1 rounded-full ml-2">
        <%= @project.status.titleize %>
      </span>
    </div>

    <% if @project.repository.present? %>

      <hr class="my-6">

      <div class="grid grid-cols-2 gap-4">

        <div>
          <strong>Default Branch</strong><br>
          <%= @project.repository.default_branch %>
        </div>

        <div>
          <strong>Total Commits</strong><br>
          <%= number_with_delimiter(@project.repository.commit_count) %>
        </div>

        <div>
          <strong>HEAD SHA</strong><br>
          <code><%= @project.repository.head_sha.first(10) %></code>
        </div>

        <div>
          <strong>Repository Size</strong><br>
          <%= number_to_human_size(@project.repository.repository_size) %>
        </div>

      </div>

    <% end %>

    <%= button_to "Analyze Repository",
          analyze_project_path(@project),
          method: :post,
          class: "bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-3 rounded-lg" %>

  </div>

</div>